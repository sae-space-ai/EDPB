# =============================================================================
# EDPB-SUPER-ECOSYSTEM v4.0 - Variables de Entorno
# Copia este archivo a .env y rellena los valores
# =============================================================================

# =============================================================================
# APIs de LLMs (Obtener en las URLs indicadas)
# =============================================================================

# Google Gemini API
# Obtener en: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Groq API
# Obtener en: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token
# Obtener en: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_TOKEN=your_huggingface_token_here

# NVIDIA API
# Obtener en: https://build.nvidia.com/
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here

# DeepSeek API
# Obtener en: https://platform.deepseek.com/
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Mistral API
# Obtener en: https://console.mistral.ai/
VITE_MISTRAL_API_KEY=your_mistral_api_key_here

# Cerebras API
# Obtener en: https://cloud.cerebras.ai/
VITE_CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenRouter API (opcional)
# Obtener en: https://openrouter.ai/
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# Base de Datos
# =============================================================================

# PostgreSQL Connection String
# Formato: postgresql://user:password@host:port/database
# Ejemplo Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Ejemplo Neon: postgresql://user:password@host.neon.tech/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/edpb_ecosystem

# Pool de conexiones (opcional)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# Ecosistema
# =============================================================================

# Nombre del ecosistema
ECOSYSTEM_NAME=EDPB-SUPER-ECOSYSTEM

# Versión
ECOSYSTEM_VERSION=4.0.0

# Modo de operación (continuous, test, maintenance)
ECOSYSTEM_MODE=continuous

# Intervalo de health check en segundos
HEALTH_CHECK_INTERVAL=30

# Tamaño máximo del log
MAX_LOG_SIZE=1000

# =============================================================================
# Vercel (para despliegue)
# =============================================================================

# Vercel Token
# Obtener en: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# Vercel Organization ID
# Obtener en: https://vercel.com/dashboard (URL de tu organización)
VERCEL_ORG_ID=your_vercel_org_id_here

# Vercel Project ID
# Obtener ejecutando: vercel inspect
VERCEL_PROJECT_ID=your_vercel_project_id_here

# =============================================================================
# Seguridad
# =============================================================================

# Secret Key para JWT (generar con: openssl rand -hex 32)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Token de autenticación para APIs sensibles
API_AUTH_TOKEN=your_api_auth_token_here

# CORS Origins (separados por coma)
CORS_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

# =============================================================================
# Monitoreo (opcional)
# =============================================================================

# Sentry DSN (para tracking de errores)
# Obtener en: https://sentry.io/
SENTRY_DSN=your_sentry_dsn_here

# Logtail Token (para logs centralizados)
# Obtener en: https://logtail.com/
LOGTAIL_TOKEN=your_logtail_token_here

# =============================================================================
# Desarrollo
# =============================================================================

# Modo de desarrollo (true/false)
NODE_ENV=development

# Puerto del servidor de desarrollo
PORT=3000

# Habilitar logs detallados (true/false)
DEBUG_MODE=false

# =============================================================================
# FIN DE VARIABLES DE ENTORNO
# =============================================================================

# Instrucciones:
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena los valores necesarios
# 3. NO subas .env a Git (ya está en .gitignore)
# 4. Para Vercel, configura las variables en el dashboard
